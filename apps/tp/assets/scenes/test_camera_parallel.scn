// OVERVIEW: test_camera_parallel.scn
// ========
// Test scene: parallel projection.
// Rows of boxes going away from the camera, seen by a parallel camera with
// view height 12 and clipping planes at 1 and 100.
//
// Editor: boxes far away have the same size as the near ones and the
// rows stay parallel (no vanishing point).
// Ray tracing: same image, rendered with parallel rays.

include "colors.inc"

material "Red" { diffuse Red specular White metallic 0 roughness 0.4 }
material "Green" { diffuse Green specular White metallic 0 roughness 0.4 }

scene
{
  environment
  {
    background DarkGray
    ambient Gray
  }

  object "Camera"
  {
    define pos <8, 8, 12>

    transform
    {
      position pos
      rotation axes(pos, <0, 1, 0>)
    }
    camera { parallel height 12 depth vec2(1, 100) }
  }

  object "Light"
  {
    transform { rotation <-50, 30, 0> }
    light { directional }
  }

  object "R0" { transform { position <-2, 0, 4> } mesh "Box" material "Red" }
  object "R1" { transform { position <-2, 0, 0> } mesh "Box" material "Red" }
  object "R2" { transform { position <-2, 0, -4> } mesh "Box" material "Red" }
  object "R3" { transform { position <-2, 0, -8> } mesh "Box" material "Red" }
  object "G0" { transform { position <2, 0, 4> } mesh "Box" material "Green" }
  object "G1" { transform { position <2, 0, 0> } mesh "Box" material "Green" }
  object "G2" { transform { position <2, 0, -4> } mesh "Box" material "Green" }
  object "G3" { transform { position <2, 0, -8> } mesh "Box" material "Green" }
}
