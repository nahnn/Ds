// OVERVIEW: test_default_material.scn
// ========
// Test scene: meshes without material.
// The reader assigns "Default PBR" to each of them.
//
// Editor: the Inspector shows "Default PBR" for both objects.
// Ray tracing: both are rendered with the same gray dielectric material.

scene
{
  environment
  {
    background rgb(0.761, 0.761, 0.761)
    ambient rgb(0.15, 0.15, 0.15)
  }

  object "Camera"
  {
    transform { position <0, 0, 10> }
    camera { perspective angle 45 }
  }

  object "Light"
  {
    transform { position <5, 5, 10> }
    light { point }
  }

  object "Directional Light"
  {
    transform { rotation <50, 30, 0> }
    light { directional }
  }

  object "Sphere" { transform { position <-1.5, 0, 0> } mesh "Sphere" }
  object "Box" { transform { position <1.5, 0, 0> rotation <30, 45, 0> } mesh "Box" }
}
