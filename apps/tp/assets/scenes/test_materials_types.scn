// OVERVIEW: test_materials_types.scn
// ========
// Test scene: every kind of material.
// Top row: PBR dielectrics (plastic, rubber) and metals (gold, copper,
// silver, chrome). Bottom row: Phong materials (no metallic/roughness),
// converted to PBR by PBR::toPBR (the reader prints a warning for each one).
//
// Editor: plastic has a sharp white highlight; rubber is almost matte;
// metals have no diffuse color and a highlight tinted by the metal.
// Ray tracing: chrome and silver reflect the floor and the neighbors.

include "colors.inc"

material "PhongShiny" { ambient Red diffuse Red spot White shine 100 specular White }
material "PhongMatte" { ambient Green diffuse Green spot Black shine 1 specular Black }
material "PhongMetal" { ambient Bronze * 0.5 diffuse Black spot Bronze shine 100 specular Bronze }
material "PhongGlass" { diffuse Blue spot White shine 200 specular White transparency White * 0.8 ior 1.5 }

material "Plastic" { diffuse Red specular White metallic 0 roughness 0.2 }
material "Rubber" { diffuse Gray specular White metallic 0 roughness 0.9 }
material "Gold" { diffuse Gold specular Gold metallic 1 roughness 0.3 }
material "Copper" { diffuse Copper specular Copper metallic 1 roughness 0.4 }
material "Silver" { diffuse Silver specular Silver metallic 1 roughness 0.15 }
material "Chrome" { diffuse White specular White metallic 1 roughness 0.05 }
material "Floor" { diffuse VeryLightGray specular White metallic 0 roughness 0.7 }

scene
{
  environment
  {
    background DarkGray
    ambient Gray
  }

  object "Camera"
  {
    define pos <0, 4, 16>

    transform
    {
      position pos
      rotation axes(pos - <0, 0, 0>, <0, 1, 0>)
    }
    camera { perspective angle 45 }
  }

  object "Light"
  {
    transform { position <5, 10, 10> }
    light { point color White }
  }

  object "Floor"
  {
    transform { position <0, -1, 0> scale vec3(20) }
    mesh "Plane" material "Floor"
  }

  object "Plastic" { transform { position <-6.25, 2.5, 0> } mesh "Sphere" material "Plastic" }
  object "Rubber" { transform { position <-3.75, 2.5, 0> } mesh "Sphere" material "Rubber" }
  object "Gold" { transform { position <-1.25, 2.5, 0> } mesh "Sphere" material "Gold" }
  object "Copper" { transform { position <1.25, 2.5, 0> } mesh "Sphere" material "Copper" }
  object "Silver" { transform { position <3.75, 2.5, 0> } mesh "Sphere" material "Silver" }
  object "Chrome" { transform { position <6.25, 2.5, 0> } mesh "Sphere" material "Chrome" }

  object "PhongShiny" { transform { position <-3.75, 0, 0> } mesh "Sphere" material "PhongShiny" }
  object "PhongMatte" { transform { position <-1.25, 0, 0> } mesh "Sphere" material "PhongMatte" }
  object "PhongMetal" { transform { position <1.25, 0, 0> } mesh "Sphere" material "PhongMetal" }
  object "PhongGlass" { transform { position <3.75, 0, 0> } mesh "Sphere" material "PhongGlass" }
}
