// OVERVIEW: test_invalid_metallic.scn
// ========
// Test scene: metallic out of [0, 1].
//
// Expected: the reader stops with "Invalid value for 'metallic'" and the
// current scene is kept.

material "Metal" { diffuse rgb(1, 0, 0) metallic 2 roughness 0.5 }

scene
{
  object "Sphere" { mesh "Sphere" material "Metal" }
}
