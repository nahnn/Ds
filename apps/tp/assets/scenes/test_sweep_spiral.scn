// OVERVIEW: test_sweep_spiral.scn
// ========
// Test scene: spiral sweeps.
// Front row: closed square (capped), open arc, extruded hexagon (capped,
// but extruded) and triangle (3 points, the minimum).
// Back row: revolutions 3, height increment 2, width increment 1 and
// subdivisions 3 (minimum), all with the same circular profile.
//
// Editor: only the square has caps (the arc is open and the hexagon is
// extruded); in the Inspector, Capped is disabled for the arc and the
// hexagon. The back row shows more turns, a taller spiral, a cone shaped
// spiral and a coarse spiral.
// Ray tracing: same meshes.
// Save: File > Save writes test_roundtrip.scn (the scene name), which
// must show the same objects when opened.

include "colors.inc"

material "Orange" { diffuse Orange specular White metallic 0 roughness 0.3 }
material "Copper" { diffuse Copper specular Copper metallic 1 roughness 0.3 }

scene "test_roundtrip"
{
  environment
  {
    background DarkGray
    ambient Gray
  }

  object "Camera"
  {
    define pos <0, 12, 30>

    transform
    {
      position pos
      rotation axes(pos - <0, 2, 0>, <0, 1, 0>)
    }
    camera { perspective angle 45 }
  }

  object "Light"
  {
    transform { rotation <-50, 30, 0> }
    light { directional }
  }

  object "Square"
  {
    transform { position <-12, 0, 5> }
    spiral "Square" material "Orange"
    {
      polyline { regularPolygon points 4 scale 0.5 }
      capped width 2 revolutions 1.5 heightIncrement 1
    }
  }

  object "Arc"
  {
    transform { position <-4, 0, 5> }
    spiral "Arc" material "Orange"
    {
      polyline { circularArc angle 180 segments 8 open scale 0.5 }
      capped width 2 revolutions 1.5 heightIncrement 1
    }
  }

  object "Extruded"
  {
    transform { position <4, 0, 5> }
    spiral "Extruded" material "Orange"
    {
      polyline { regularPolygon points 6 scale 0.5 extrusion 0.5 }
      capped width 2 revolutions 1.5 heightIncrement 1
    }
  }

  object "Triangle"
  {
    transform { position <12, 0, 5> }
    spiral "Triangle" material "Orange"
    {
      polyline { regularPolygon points 3 scale 0.5 rotation 90 }
      capped width 2 revolutions 1.5 heightIncrement 1
    }
  }

  object "Revolutions"
  {
    transform { position <-12, 0, -5> }
    spiral "Revolutions" material "Copper"
    {
      polyline { circularArc angle 360 segments 12 scale 0.3 }
      width 2 revolutions 3 heightIncrement 1
    }
  }

  object "Height"
  {
    transform { position <-4, 0, -5> }
    spiral "Height" material "Copper"
    {
      polyline { circularArc angle 360 segments 12 scale 0.3 }
      width 2 revolutions 2 heightIncrement 2
    }
  }

  object "Width"
  {
    transform { position <4, 0, -5> }
    spiral "Width" material "Copper"
    {
      polyline { circularArc angle 360 segments 12 scale 0.3 }
      width 1 revolutions 2 heightIncrement 1 widthIncrement 1
    }
  }

  object "Coarse"
  {
    transform { position <12, 0, -5> }
    spiral "Coarse" material "Copper"
    {
      polyline { circularArc angle 360 segments 12 scale 0.3 }
      width 2 revolutions 2 heightIncrement 1 subdivisions 3
    }
  }
}
