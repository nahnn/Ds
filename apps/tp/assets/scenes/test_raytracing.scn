// OVERVIEW: test_raytracing.scn
// ========
// Test scene: ray tracing features.
// Two mirrors face each other with a red sphere between them, over a
// smooth dark floor; a point light casts shadows on the floor.
//
// Editor: no reflections and no shadows (OpenGL shading only).
// Ray tracing: the mirrors show a sequence of sphere images that ends when
// the ray weight gets below Min Weight (try 0.001, 0.05 and 0.3 and compare
// the number of rays printed in the console); the sphere and the box cast
// shadows; the floor reflects more toward the horizon (Fresnel).

include "colors.inc"

material "Mirror" { diffuse White specular White metallic 1 roughness 0.05 }
material "Floor" { diffuse Gray specular White metallic 0 roughness 0.05 }
material "Red" { diffuse Red specular White metallic 0 roughness 0.3 }
material "Blue" { diffuse Blue specular White metallic 0 roughness 0.6 }

scene
{
  environment
  {
    background rgb(0.2, 0.3, 0.5)
    ambient DarkGray
  }

  object "Camera"
  {
    define pos <2, 3, 12>

    transform
    {
      position pos
      rotation axes(pos, <0, 1, 0>)
    }
    camera { perspective angle 50 }
  }

  object "Light"
  {
    transform { position <3, 8, 5> }
    light { point }
  }

  object "Floor"
  {
    transform { position <0, -1, 0> scale vec3(20) }
    mesh "Plane" material "Floor"
  }

  object "Left Mirror"
  {
    transform { position <-4, 1.5, 0> scale <0.1, 2.5, 4> }
    mesh "Box" material "Mirror"
  }

  object "Right Mirror"
  {
    transform { position <4, 1.5, 0> scale <0.1, 2.5, 4> }
    mesh "Box" material "Mirror"
  }

  object "Sphere" { transform { position <0, 0, 0> } mesh "Sphere" material "Red" }
  object "Box" { transform { position <1.5, -0.5, 2.5> rotation <0, 30, 0> scale vec3(0.5) } mesh "Box" material "Blue" }
}
