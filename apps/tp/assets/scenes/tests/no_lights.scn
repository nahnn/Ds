// OVERVIEW: no_lights.scn
// ========
// Test scene: scene without lights.
//
// Editor: the objects are lit by the default light of USceneEditor, a point
// light at the camera; the light follows the camera when it moves.
// Ray tracing: only the ambient light reaches the objects.

include "../colors.inc"

material "Red" { diffuse Red specular White metallic 0 roughness 0.3 }
material "Gold" { diffuse Gold specular Gold metallic 1 roughness 0.3 }

scene
{
  environment
  {
    background DarkGray
    ambient Gray
  }

  object "Camera"
  {
    transform { position <0, 0, 10> }
    camera { perspective angle 45 }
  }

  object "Sphere" { transform { position <-1.5, 0, 0> } mesh "Sphere" material "Red" }
  object "Box" { transform { position <1.5, 0, 0> rotation <30, 45, 0> } mesh "Box" material "Gold" }
}
