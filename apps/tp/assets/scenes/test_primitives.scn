// OVERVIEW: test_primitives.scn
// ========
// Test scene: meshes.
// The five default meshes (Box, Sphere, Cylinder, Cone, Plane) and the
// external mesh f-16.obj, loaded from assets/meshes.
//
// Editor: all meshes are shown; the Inspector lists the mesh name of each
// object and the "..." button lists every mesh of the assets.
// Ray tracing: same meshes, including the f-16 triangles.

include "colors.inc"

material "Gray" { diffuse VeryLightGray specular White metallic 0 roughness 0.5 }
material "Steel" { diffuse Silver specular Silver metallic 1 roughness 0.35 }

scene
{
  environment
  {
    background rgb(0.761, 0.761, 0.761)
    ambient Gray
  }

  object "Camera"
  {
    define pos <0, 6, 14>

    transform
    {
      position pos
      rotation axes(pos, <0, 1, 0>)
    }
    camera { perspective angle 50 }
  }

  object "Directional Light"
  {
    transform { rotation <50, 30, 0> }
    light { directional }
  }

  object "Plane" { transform { position <0, -1, 0> scale vec3(10) } mesh "Plane" material "Gray" }
  object "Box" { transform { position <-5, 0, 0> rotation <0, 30, 0> } mesh "Box" material "Gray" }
  object "Sphere" { transform { position <-2.5, 0, 0> } mesh "Sphere" material "Gray" }
  object "Cylinder" { transform { position <0, 0, 0> } mesh "Cylinder" material "Gray" }
  object "Cone" { transform { position <2.5, 0, 0> } mesh "Cone" material "Gray" }
  object "F-16" { transform { position <5, 0.5, 0> scale vec3(2) } mesh "f-16.obj" material "Steel" }
}
