// OVERVIEW: test_lights_falloff.scn
// ========
// Test scene: falloff and range of point lights.
// Four floor tiles, each lit by its own point light 2 units above it:
// constant, linear and quadratic falloff with range 7, and linear falloff
// with infinite range (range 0).
//
// Editor: on the first three tiles the light ends in a circle of radius
// about 6.7; it is flat inside (constant), fades linearly (linear) or fades
// faster near the center (quadratic). The last tile is never fully dark.
// Ray tracing: same result.

include "colors.inc"

material "Floor" { diffuse White specular White metallic 0 roughness 1 }

scene
{
  environment
  {
    background rgb(0.761, 0.761, 0.761)
    ambient Black
  }

  object "Camera"
  {
    define pos <0, 40, 25>

    transform
    {
      position pos
      rotation axes(pos, <0, 1, 0>)
    }
    camera { perspective angle 45 }
  }

  object "Constant"
  {
    transform { position <-24, -1, 0> scale vec3(7.5) }
    mesh "Plane" material "Floor"
  }

  object "Constant Light"
  {
    transform { position <-24, 1, 0> }
    light { point falloff 0 range 7 }
  }

  object "Linear"
  {
    transform { position <-8, -1, 0> scale vec3(7.5) }
    mesh "Plane" material "Floor"
  }

  object "Linear Light"
  {
    transform { position <-8, 1, 0> }
    light { point falloff 1 range 7 }
  }

  object "Quadratic"
  {
    transform { position <8, -1, 0> scale vec3(7.5) }
    mesh "Plane" material "Floor"
  }

  object "Quadratic Light"
  {
    transform { position <8, 1, 0> }
    light { point falloff 2 range 7 }
  }

  object "Infinite"
  {
    transform { position <24, -1, 0> scale vec3(7.5) }
    mesh "Plane" material "Floor"
  }

  object "Infinite Light"
  {
    transform { position <24, 1, 0> }
    light { point falloff 1 }
  }
}
